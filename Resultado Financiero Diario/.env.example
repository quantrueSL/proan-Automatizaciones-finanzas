SENDGRID_API_KEY=coloca-aqui-tu-api-key-de-sendgrid
SENDGRID_FROM_EMAIL=noreply@proan.com

# Fallback de destinatarios (nivel 2 de la cascada, ver enviar_reporte.py): solo se usa si
# Firestore no tiene la lista, está deshabilitada o no responde. El destinatario real de
# producción se administra en Firestore (base proan-lista-mails, colección lists, documento
# resultado_financiero_diario).
RESULTADO_DIARIO_EMAIL_TO=
# Si vale "true", no envía correo real (solo loguea qué habría mandado). Útil para probar el
# Job ya desplegado en Cloud Run sin gastar un envío -- el flag --dry-run no se puede pasar ahí.
RESULTADO_DIARIO_EMAIL_DRY_RUN=false

# Solo si necesitas apuntar a otra base/colección/documento Firestore -- normalmente no hace
# falta definir estas tres, los defaults en config.py ya son los correctos.
FIRESTORE_DATABASE_ID=proan-lista-mails
FIRESTORE_LISTS_COLLECTION=lists
RESULTADO_DIARIO_LIST_ID=resultado_financiero_diario

# Solo para Cloud Run (deploy.sh la inyecta como env var del Job) -- no hace falta definirla
# para ejecución local, ahí manda el OUTPUT_DIR fijo de Windows en config.py.
OUTPUT_DIR=
