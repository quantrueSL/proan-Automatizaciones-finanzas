SENDGRID_API_KEY=SG_REEMPLAZAR
SENDGRID_FROM_EMAIL=noreply@proan.com

# Mientras se prueba: true no envia nada y deja el HTML en salida_dry_run/
BLOQUEADOS_EMAIL_DRY_RUN=true

# Recorta la ejecucion a unas pocas sociedades. Vacio = las 23.
BLOQUEADOS_ONLY_SOCIEDADES=

# Solo se usa si Firestore no tiene lista: envia unicamente el correo global.
BLOQUEADOS_EMAIL_TO=pcoma@quantrue.com

# Horas de antiguedad tolerables en clientes_bloqueados antes de abortar. No hay
# _ingested_at: se mide sobre la fecha de modificacion de la tabla.
BLOQUEADOS_MAX_ANTIGUEDAD_HORAS=30

FIRESTORE_DATABASE_ID=proan-lista-mails
FIRESTORE_LISTS_COLLECTION=lists
BLOQUEADOS_LIST_ID=clientes_bloqueados
