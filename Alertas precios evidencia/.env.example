# Copia este archivo como .env y rellena la clave. El .env nunca se sube al repositorio ni a la imagen.
SENDGRID_API_KEY=coloca-aqui-tu-api-key-de-sendgrid
SENDGRID_FROM_EMAIL=noreply@proan.com

# "true": genera el PDF pero no envía el correo ni registra alertas como enviadas (para probar ya desplegado).
# Dejarlo en true hasta validar el primer envío.
ALERTAS_EVIDENCIA_EMAIL_DRY_RUN=true

# Lista de destinatarios en Firestore (base proan-lista-mails, colección lists). Normalmente no hace falta tocarlas.
ALERTAS_EVIDENCIA_LIST_ID=alertas-precios-evidencia
FIRESTORE_DATABASE_ID=proan-lista-mails
FIRESTORE_LISTS_COLLECTION=lists

# Solo para pruebas locales: ejecutar como si fuera otro día (AAAA-MM-DD). Vacío = hoy.
FECHA_EJECUCION=

# Solo para Cloud Run (deploy.sh la inyecta como /tmp/salidas). En local se usa la carpeta salidas/.
OUTPUT_DIR=
