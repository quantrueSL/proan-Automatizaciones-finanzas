SENDGRID_API_KEY=SG_REEMPLAZAR
SENDGRID_FROM_EMAIL=noreply@proan.com

# Mientras se prueba: true no envia nada y deja el HTML en salida_dry_run/
PARTIDAS_EMAIL_DRY_RUN=true

# Recorta la ejecucion a unas pocas sociedades. Vacio = las 16.
PARTIDAS_ONLY_SOCIEDADES=

# Solo se usa si Firestore no tiene lista: envia unicamente el correo global.
PARTIDAS_EMAIL_TO=pcoma@quantrue.com

# Horas de antiguedad tolerables en el espejo de BSIS antes de abortar. Ojo: BSIS carga
# de madrugada y no se mueve el resto del dia, al contrario que BSIK, que va cada dos
# horas. De ahi que aqui sean 20 y en anticipos 6.
PARTIDAS_MAX_ANTIGUEDAD_HORAS=20

FIRESTORE_DATABASE_ID=proan-lista-mails
FIRESTORE_LISTS_COLLECTION=lists
PARTIDAS_LIST_ID=partidas_pendientes
